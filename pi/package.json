{
  "name": "pi-config",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run \"/^check:.*/\"",
    "check:format": "oxfmt extensions --check",
    "check:lint": "oxlint extensions",
    "check:test": "node --test --test-concurrency=1 extensions/guardrails/tests/*.test.ts extensions/tests/*.test.ts",
    "check:types": "tsc --noEmit",
    "format": "oxfmt extensions"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.2",
    "diff": "^9.0.0",
    "typebox": "1.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0"
}
